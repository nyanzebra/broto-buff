{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Specification",
  "description": "Represents the entire specification, including type definitions and requests/responses.",
  "type": "object",
  "properties": {
    "requests": {
      "description": "The enum definition for requests.",
      "$ref": "#/$defs/EnumDefinition"
    },
    "responses": {
      "description": "The enum definition for responses.",
      "$ref": "#/$defs/EnumDefinition"
    },
    "types": {
      "description": "The collection of type definitions and modules.",
      "$ref": "#/$defs/Types"
    }
  },
  "required": [
    "types",
    "requests",
    "responses"
  ],
  "$defs": {
    "EnumDefinition": {
      "description": "Represents an enum definition.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name of the enum.",
          "$ref": "#/$defs/TypeName"
        },
        "variants": {
          "description": "The variants in the enum.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnumVariant"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "EnumVariant": {
      "description": "Represents a single variant in an enum (struct, tuple, or unit).",
      "oneOf": [
        {
          "description": "Represents a struct variant.",
          "type": "object",
          "properties": {
            "fields": {
              "description": "The fields of the struct.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Field"
              }
            },
            "kind": {
              "type": "string",
              "const": "Struct"
            },
            "name": {
              "description": "The name of the struct.",
              "$ref": "#/$defs/TypeName"
            },
            "tag": {
              "description": "The tag value, if any.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "description": "Represents a tuple variant.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "Tuple"
            },
            "name": {
              "description": "The name of the tuple.",
              "$ref": "#/$defs/TypeName"
            },
            "tag": {
              "description": "The tag value, if any.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "types": {
              "description": "The types in the tuple.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypeName"
              }
            }
          },
          "required": [
            "kind",
            "name",
            "types"
          ]
        },
        {
          "description": "Represents a unit variant.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "Unit"
            },
            "name": {
              "description": "The name of the unit variant.",
              "$ref": "#/$defs/TypeName"
            },
            "tag": {
              "description": "The tag value, if any.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "name"
          ]
        }
      ]
    },
    "Field": {
      "description": "Represents a field in a struct or enum.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name of the field.",
          "type": "string"
        },
        "type": {
          "description": "The type of the field.",
          "$ref": "#/$defs/TypeName"
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "Module": {
      "description": "Represents a module containing type definitions.",
      "type": "object",
      "properties": {
        "mods": {
          "description": "The submodules in the module.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Module"
          }
        },
        "name": {
          "description": "The name of the module.",
          "type": "string"
        },
        "types": {
          "description": "The type definitions in the module.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeDefinition"
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "StructDefinition": {
      "description": "Represents a struct definition.",
      "type": "object",
      "properties": {
        "fields": {
          "description": "The fields of the struct.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Field"
          }
        },
        "name": {
          "description": "The name of the struct.",
          "$ref": "#/$defs/TypeName"
        }
      },
      "required": [
        "name"
      ]
    },
    "TupleDefinition": {
      "description": "Represents a struct tuple definition.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The name of the tuple.",
          "$ref": "#/$defs/TypeName"
        },
        "types": {
          "description": "The types in the tuple.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeName"
          }
        }
      },
      "required": [
        "name",
        "types"
      ]
    },
    "TypeDefinition": {
      "description": "Represents a type definition (enum, struct, or tuple).",
      "oneOf": [
        {
          "description": "Represents an enum definition.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "Enum"
            }
          },
          "$ref": "#/$defs/EnumDefinition",
          "required": [
            "kind"
          ]
        },
        {
          "description": "Represents a struct definition.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "Struct"
            }
          },
          "$ref": "#/$defs/StructDefinition",
          "required": [
            "kind"
          ]
        },
        {
          "description": "Represents a tuple definition.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "Tuple"
            }
          },
          "$ref": "#/$defs/TupleDefinition",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "TypeName": {
      "description": "Represents a type name, optionally with a module prefix.\nThe module prefix should be a fully qualified module path.",
      "type": "object",
      "properties": {
        "module": {
          "description": "The module prefix, if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "The name of the type.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "Types": {
      "description": "Represents a collection of type definitions and modules.\nThis is the global module that contains all type definitions and submodules.",
      "type": "object",
      "properties": {
        "definitions": {
          "description": "The type definitions in the global module.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypeDefinition"
          }
        },
        "modules": {
          "description": "The submodules in the global module.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Module"
          }
        }
      },
      "required": [
        "definitions"
      ]
    }
  }
}
